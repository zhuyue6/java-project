<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ======================== 【项目信息】 ======================== -->

    <!-- 【1. 修改这里】你的项目 GAV 坐标 -->
    <!-- groupId：组织/公司/个人标识（反向域名） -->
    <groupId>com.zhuyue</groupId>
    <!-- artifactId：项目名称（自己定义，见名知意即可） -->
    <artifactId>apps</artifactId>
    <!-- version：版本号，1.0.0 正式版，SNAPSHOT 是开发版 -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- packaging：打包方式，jar = 可执行jar包，war = web项目, pom = 父项目 -->
    <packaging>pom</packaging>

     <!-- 项目名称，随便写，方便看 -->
    <name>apps</name>
    <description>应用集合</description>


    <!-- 子项目列表， 在根目录进行mvn clean install 时，会自动编译子项目 -->
    <modules>
        <module>clock-in-app</module>
        <!-- <module>java-workbook</module> -->
    </modules>


    <!-- ======================== 【自定义属性】 ======================== -->    
    <!-- 【2. 修改这里】属性配置：指定 Java 版本 -->
    <properties>
        <!-- 源代码使用的 JDK 版本 → 你是 JDK 26 -->
        <maven.compiler.source>17</maven.compiler.source>
        <!-- 编译后目标 JDK 版本 → 你是 JDK 26 -->
        <maven.compiler.target>17</maven.compiler.target>
        <!-- release：真正控制编译兼容的 JDK 版本（JDK 9+ 必须加） -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- 编码格式 UTF-8，解决中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    </properties>

    <!-- ======================== 【继承父级Pom】 ======================== -->    
    <!-- "继承"一个官方的「版本总管」项目 -->
    <parent> 
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <!-- 去本地 Maven 仓库 / 远程中央仓库找 parent，不从本地路径找 -->
        <relativePath/>
    </parent>

    <!-- ======================== 【构建配置】 ======================== -->

    <!--
    1. 编译插件：负责把 .java → .class
    2. 打包插件：如果是可执行 jar，需要配置主类
    3. Spring Boot 打包插件（必须加，否则打出来的jar无法直接运行）
    
    -->
    <build>
        <!-- 源代码目录 -->
        <sourceDirectory>src/main/java</sourceDirectory>
        <!-- 测试源代码目录 -->
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <!-- 编译输出目录 -->
        <outputDirectory>target/classes</outputDirectory>
        <!-- 测试编译输出目录 -->
        <testOutputDirectory>target/test-classes</testOutputDirectory>
        <!-- 资源目录 -->
        <resources>
            <!-- 
               指定哪些文件属于「资源文件」，构建时会自动复制到 classpath（classes 目录），支持变量过滤（占位符替换）。
               这是最常用的配置之一，SpringBoot 里 application.yml 中的 @project.version@ 变量生效，就依赖这个配置。
             -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <!-- 编译、打包用到的插件 -->
        <plugins>
            <!-- 1. 编译插件：负责把 .java → .class -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source> <!-- 源码 JDK 版本 -->
                    <target>${maven.compiler.target}</target> <!-- 编译 JDK 版本 -->
                    <release>${maven.compiler.release}</release> <!-- 真正生效的 JDK 版本 -->
                    <encoding>${project.build.sourceEncoding}</encoding> <!-- 编码 -->
                </configuration>
            </plugin>

            <!-- 打包插件：如果是可执行 jar，需要配置主类 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- 【修改这里】你的主类全限定名（包名+类名） -->
                            <mainClass>com.zhuyue.clockin.Application</mainClass>
                            <!-- 自动添加依赖路径（默认开启） -->
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Spring Boot 打包插件（必须加，否则打出来的jar无法直接运行） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <!-- 排除 Lombok 插件，否则打出来的jar无法直接运行 -->
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>