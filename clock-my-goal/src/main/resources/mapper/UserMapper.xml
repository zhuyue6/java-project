<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace 必须与 Mapper 接口的全限定名完全一致 -->
<mapper namespace="com.zhuyue.clockMyGoal.modules.user.mapper.UserMapper">
    <!-- 定义映射关系：type指定实体类 -->
    <!-- 根据ID查询用户，id与接口方法名一致，resultType与返回值类型一致 -->
    <select id="selectByUserId" resultType="com.zhuyue.clockMyGoal.modules.user.entity.User">
        SELECT * FROM user WHERE id = #{id}
    </select>
    <!-- 根据userName查询用户，resultType与返回值类型一致 -->
    <select id="selectByUserName" resultType="com.zhuyue.clockMyGoal.modules.user.entity.User">
        SELECT * FROM user WHERE user_name = #{userName}
    </select>
    <!-- 查询所有用户 -->
    <select id="selectAllUsers" resultType="com.zhuyue.clockMyGoal.modules.user.entity.User">
        SELECT * FROM user
    </select>

    <sql id="UserWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                AND user_name LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectCountUsers" resultType="long">
        SELECT COUNT(*) FROM user
        <include refid="UserWhere"/>
    </select>

    <select id="selectUserList" resultType="com.zhuyue.clockMyGoal.modules.user.entity.User">
        SELECT * FROM user
        <include refid="UserWhere"/>
        ORDER BY update_time DESC, id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 创建用户：useGeneratedKeys 把数据库自增主键回写到 User.id -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO user(user_name, password, sex, age, status) VALUES(#{userName}, #{password}, #{sex}, #{age}, #{status})
    </insert>

    <!-- 更新用户头像 -->
    <update id="updateAvatarByUserId">
        UPDATE user SET avatar_url = #{avatarUrl} WHERE id = #{id}
    </update>

    <!-- 更新用户状态 -->
    <update id="updateUserStatus">
        UPDATE user SET status = #{status} WHERE id = #{id}
    </update>
</mapper>